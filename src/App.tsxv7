import { useEffect, useMemo, useRef, useState } from "react";
import { AnimatePresence, motion } from "framer-motion";
import ThreeBackground from "./ThreeBackground";

type Mode = "home" | "about" | "projects" | "contact" | "help";

type Project = {
  name: string;
  title: string;
  stack: string[];
  description: string;
};

type HistoryEntry = {
  command: string;
  output?: string;
  type?: "project";
  project?: Project;
};

type CommandResult = {
  clear?: boolean;
  mode?: Mode;
  output?: string;
  type?: "project";
  project?: Project;
};

const PROJECTS: Record<string, Project> = {
  "ai-puzzle": {
    name: "ai-puzzle",
    title: "AI Puzzle Game for Android",
    stack: ["Android", "Unity", "AI Logic", "Accessibility", "UI/UX"],
    description:
      "An Android puzzle game concept with adaptive difficulty, accessible interaction patterns, and polished UI/UX design.",
  },
  "pet-holder": {
    name: "pet-holder",
    title: "Modular Pet Bottle Holder",
    stack: ["3D Design", "PLA", "Unity AR", "Product UX"],
    description:
      "A customizable modular bottle holder for pets with multiple mounting options and AR visualization.",
  },
  "creative-ui": {
    name: "creative-ui",
    title: "Accessible Creative UI System",
    stack: [
      "Figma",
      "Adobe XD",
      "Photoshop",
      "Illustrator",
      "Accessibility",
      "UI/UX",
    ],
    description:
      "A visual design system focused on accessible interfaces, strong contrast, readable layouts, and modern interaction patterns.",
  },
};

const FILE_SYSTEM: Record<string, any> = {
  home: {
    about:
      "Viktoriya builds interactive web interfaces, accessible UI/UX systems, AI-assisted experiences, and creative digital products.",
    contact:
      "Email: your@email.com\nGitHub: github.com/yourname\nLinkedIn: linkedin.com/in/yourname",
    projects: Object.fromEntries(
      Object.keys(PROJECTS).map((name) => [name, `project:${name}`])
    ),
  },
};

const BASE_SHORTCUTS = [
  "help",
  "whoami",
  "contact",
  "ls",
  "pwd",
  "cd projects",
  "cd ..",
  "cat about",
  "cat contact",
  "ask what projects do you have?",
];

const PROJECT_SHORTCUTS = Object.keys(PROJECTS).map((name) => `cat ${name}`);
const SHORTCUTS = [...BASE_SHORTCUTS, ...PROJECT_SHORTCUTS, "clear"];

const ASCII_LOGO = String.raw`
 ___      ___ ___  ___  __    _________  ________  ________  ___      ___    ___ ________          _____ ______   ___  ___  __    ___  ___  ________      ___    ___ ___       ________  ___      ___ ________     
|\  \    /  /|\  \|\  \|\  \ |\___   ___\\   __  \|\   __  \|\  \    |\  \  /  /|\   __  \        |\   _ \  _   \|\  \|\  \|\  \ |\  \|\  \|\   __  \    |\  \  /  /|\  \     |\   __  \|\  \    /  /|\   __  \    
\ \  \  /  / | \  \ \  \/  /|\|___ \  \_\ \  \|\  \ \  \|\  \ \  \   \ \  \/  / | \  \|\  \       \ \  \\\__\ \  \ \  \ \  \/  /|\ \  \\\  \ \  \|\  \   \ \  \/  / | \  \    \ \  \|\  \ \  \  /  / | \  \|\  \   
 \ \  \/  / / \ \  \ \   ___  \   \ \  \ \ \  \\\  \ \   _  _\ \  \   \ \    / / \ \   __  \       \ \  \\|__| \  \ \  \ \   ___  \ \   __  \ \   __  \   \ \    / / \ \  \    \ \  \\\  \ \  \/  / / \ \   __  \  
  \ \    / /   \ \  \ \  \\ \  \   \ \  \ \ \  \\\  \ \  \\  \\ \  \   \/  /  /   \ \  \ \  \       \ \  \    \ \  \ \  \ \  \\ \  \ \  \ \  \ \  \ \  \   \/  /  /   \ \  \____\ \  \\\  \ \    / /   \ \  \ \  \ 
   \ \__/ /     \ \__\ \__\\ \__\   \ \__\ \ \_______\ \__\\ _\\ \__\__/  / /      \ \__\ \__\       \ \__\    \ \__\ \__\ \__\\ \__\ \__\ \__\ \__\ \__\__/  / /      \ \_______\ \_______\ \__/ /     \ \__\ \__\
    \|__|/       \|__|\|__| \|__|    \|__|  \|_______|\|__|\|__|\|__|\___/ /        \|__|\|__|        \|__|     \|__|\|__|\|__| \|__|\|__|\|__|\|__|\|__|\___/ /        \|_______|\|_______|\|__|/       \|__|\|__|
                                                                    \|___|/                                                                             \|___|/                                                    
`;

declare global {
  interface Window {
    __TRIGGER_PARTICLE_PULSE__?: (intensity?: number) => void;
  }
}

function portfolioAI(question: string) {
  const q = question.toLowerCase();

  if (!question.trim()) {
    return "Ask me about Viktoriya’s projects, skills, accessibility work, UI/UX, Adobe stack, or the AI puzzle game.";
  }

  if (q.includes("project") || q.includes("portfolio")) {
    return `Viktoriya currently highlights three projects:

1. ${PROJECTS["ai-puzzle"].title}
${PROJECTS["ai-puzzle"].description}

2. ${PROJECTS["pet-holder"].title}
${PROJECTS["pet-holder"].description}

3. ${PROJECTS["creative-ui"].title}
${PROJECTS["creative-ui"].description}

Use: cat ai-puzzle, cat pet-holder, or cat creative-ui.`;
  }

  if (q.includes("ai") || q.includes("puzzle") || q.includes("android")) {
    return `${PROJECTS["ai-puzzle"].title}

${PROJECTS["ai-puzzle"].description}

Suggested feature direction:
- adaptive difficulty based on player performance
- accessible color and contrast modes
- hint system that learns where the player struggles
- Android-first UX with simple touch interactions
- optional AI-generated puzzle variations`;
  }

  if (q.includes("accessibility") || q.includes("accessible")) {
    return `Accessibility focus:
- strong color contrast
- readable typography
- keyboard-friendly interactions
- clear focus states
- reduced motion option
- simple layout hierarchy
- UI patterns that work for different users and devices`;
  }

  if (q.includes("ui") || q.includes("ux") || q.includes("design")) {
    return `UI/UX focus:
Viktoriya’s design direction combines clean visual hierarchy, accessible contrast, responsive layouts, and interaction design. The creative-ui project is a good example: cat creative-ui.`;
  }

  if (
    q.includes("adobe") ||
    q.includes("photoshop") ||
    q.includes("illustrator") ||
    q.includes("xd")
  ) {
    return `Adobe stack:
- Adobe Photoshop for visual editing and assets
- Adobe Illustrator for vector graphics and icons
- Adobe XD for interface prototypes
- Figma for design systems and collaborative UI/UX work`;
  }

  if (q.includes("skill") || q.includes("stack") || q.includes("technology")) {
    return `Core skills:
React, TypeScript, Tailwind, Three.js, UI/UX, accessibility, Figma, Adobe XD, Photoshop, Illustrator, Unity, Android concepts, AI-assisted product design.`;
  }

  if (q.includes("contact") || q.includes("email")) {
    return FILE_SYSTEM.home.contact;
  }

  return `I can answer questions about:
- projects
- AI puzzle game
- accessibility
- UI/UX
- Adobe stack
- skills
- contact

Try: ask what projects do you have?`;
}

export default function App() {
  const [input, setInput] = useState("");
  const [aiInput, setAiInput] = useState("");
  const [aiAnswer, setAiAnswer] = useState(
    "Ask about projects, accessibility, UI/UX, Adobe tools, or the AI puzzle game."
  );

  const [path, setPath] = useState<string[]>(["home"]);
  const [mode, setMode] = useState<Mode>("home");
  const [activeProject, setActiveProject] = useState<string>("ai-puzzle");

  const [commandHistory, setCommandHistory] = useState<string[]>([]);
  const [historyIndex, setHistoryIndex] = useState(-1);
  const [draftInput, setDraftInput] = useState("");

  const [history, setHistory] = useState<HistoryEntry[]>([
    {
      command: "boot",
      output: "System initialized.\nType 'help' or use the shortcuts below.",
    },
  ]);

  const terminalRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    terminalRef.current?.scrollTo({
      top: terminalRef.current.scrollHeight,
      behavior: "smooth",
    });
  }, [history]);

  const currentProject = PROJECTS[activeProject];

  const getCurrentDir = () => {
    let current: any = FILE_SYSTEM;
    for (const part of path) current = current?.[part];
    return current;
  };

  const playSound = () => {
    const AudioContextClass =
      window.AudioContext || (window as any).webkitAudioContext;
    if (!AudioContextClass) return;

    const ctx = new AudioContextClass();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();

    osc.type = "sine";
    osc.frequency.value = 520;
    gain.gain.value = 0.035;

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.start();
    osc.stop(ctx.currentTime + 0.045);
  };

  const handleCommand = (raw: string): CommandResult | null => {
    const cmd = raw.trim().toLowerCase();
    if (!cmd) return null;

    const [base, ...rest] = cmd.split(/\s+/);
    const target = rest.join(" ");
    const currentDir = getCurrentDir();

    if (base === "help") {
      return {
        mode: "help",
        output: `Available commands:

Identity:
  whoami          show profile identity
  contact         show contact details

Navigation:
  ls              list files and folders
  pwd             show current path
  cd projects     open projects folder
  cd ..           go back

Open:
  cat about
  cat contact
  cat ai-puzzle
  cat pet-holder
  cat creative-ui

AI:
  ask <question>  ask the portfolio AI assistant

System:
  help            show this guide
  clear           clear terminal

Keyboard:
  Arrow Up/Down   command history`,
      };
    }

    if (base === "whoami") {
      setMode("about");
      return {
        mode: "about",
        output:
          "viktoriya — interactive UI/UX creator focused on accessible interfaces, AI-assisted experiences, creative design systems, and modern frontend development.",
      };
    }

    if (base === "contact") {
      setMode("contact");
      return {
        mode: "contact",
        output: FILE_SYSTEM.home.contact,
      };
    }

    if (base === "ask") {
      const answer = portfolioAI(target);
      setAiAnswer(answer);
      return {
        mode: "help",
        output: answer,
      };
    }

    if (base === "ls") {
      if (!currentDir || typeof currentDir !== "object") {
        return { output: "ls: not a directory" };
      }

      return {
        mode: "home",
        output: Object.keys(currentDir).join("   "),
      };
    }

    if (base === "pwd") {
      return {
        mode: "home",
        output: "/" + path.join("/"),
      };
    }

    if (base === "cd") {
      if (!target || target === "~") {
        setPath(["home"]);
        setMode("home");
        return { output: "" };
      }

      if (target === "..") {
        setPath((prev) => (prev.length > 1 ? prev.slice(0, -1) : prev));
        setMode("home");
        return { output: "" };
      }

      if (!currentDir?.[target]) {
        return { output: `cd: no such file or directory: ${target}` };
      }

      if (typeof currentDir[target] !== "object") {
        return { output: `cd: not a directory: ${target}` };
      }

      setPath((prev) => [...prev, target]);
      setMode(target === "projects" ? "projects" : "home");
      return { output: "" };
    }

    if (base === "cat") {
      if (!target) return { output: "cat: missing file name" };

      if (PROJECTS[target]) {
        setActiveProject(target);
        setMode("projects");
        return {
          mode: "projects",
          type: "project",
          project: PROJECTS[target],
        };
      }

      const item = currentDir?.[target];

      if (!item) return { output: `cat: ${target}: not found` };

      if (typeof item === "string" && item.startsWith("project:")) {
        const projectName = item.replace("project:", "");
        setActiveProject(projectName);
        setMode("projects");

        return {
          mode: "projects",
          type: "project",
          project: PROJECTS[projectName],
        };
      }

      return {
        mode: target === "about" ? "about" : target === "contact" ? "contact" : "home",
        output: String(item),
      };
    }

    if (base === "clear") {
      return {
        clear: true,
        mode: "home",
      };
    }

    return {
      output: `command not found: ${cmd}`,
    };
  };

  const submit = (override?: string) => {
    const command = (override ?? input).trim();
    if (!command) return;

    playSound();

    const intensity = command.includes("cat")
      ? 1.2
      : command.includes("cd")
      ? 0.8
      : command.includes("ask")
      ? 1.1
      : 0.5;

    window.__TRIGGER_PARTICLE_PULSE__?.(intensity);

    const result = handleCommand(command);
    if (!result) return;

    setCommandHistory((prev) => [...prev, command]);
    setHistoryIndex(-1);
    setDraftInput("");

    if (result.clear) {
      setHistory([]);
    } else {
      setHistory((prev) => [...prev, { command, ...result }]);
    }

    if (result.mode) setMode(result.mode);
    setInput("");
  };

  const submitAI = () => {
    const question = aiInput.trim();
    if (!question) return;

    playSound();
    window.__TRIGGER_PARTICLE_PULSE__?.(1);

    const answer = portfolioAI(question);
    setAiAnswer(answer);
    setHistory((prev) => [
      ...prev,
      { command: `ask ${question}`, output: answer },
    ]);
    setAiInput("");
  };

  const handleKeyDown = (event: React.KeyboardEvent<HTMLInputElement>) => {
    if (event.key === "ArrowUp") {
      event.preventDefault();

      if (commandHistory.length === 0) return;
      if (historyIndex === -1) setDraftInput(input);

      const nextIndex =
        historyIndex === -1
          ? commandHistory.length - 1
          : Math.max(0, historyIndex - 1);

      setHistoryIndex(nextIndex);
      setInput(commandHistory[nextIndex]);
      return;
    }

    if (event.key === "ArrowDown") {
      event.preventDefault();

      if (commandHistory.length === 0) return;

      const nextIndex =
        historyIndex === -1
          ? -1
          : Math.min(commandHistory.length - 1, historyIndex + 1);

      setHistoryIndex(nextIndex);
      setInput(nextIndex === -1 ? draftInput : commandHistory[nextIndex]);
      return;
    }

    if (event.key === "Enter") {
      event.preventDefault();
      submit();
    }
  };

  const currentDir = getCurrentDir();

  const directoryItems = useMemo(() => {
    if (!currentDir || typeof currentDir !== "object") return [];
    return Object.keys(currentDir);
  }, [currentDir]);

  return (
    <div className="min-h-screen overflow-hidden bg-slate-950 text-white font-mono">
      <ThreeBackground mode={mode} activeProject={activeProject} />

      <div className="pointer-events-none absolute top-4 left-1/2 z-20 w-[96vw] -translate-x-1/2 rotate-[-1deg] skew-x-[-8deg] overflow-hidden">
        <pre className="select-none whitespace-pre text-[4.5px] leading-[0.9] tracking-[-0.04em] text-cyan-300 drop-shadow-[0_0_18px_rgba(34,211,238,0.95)] opacity-95 sm:text-[6px] md:text-[7px] lg:text-[8px]">
          {ASCII_LOGO}
        </pre>
      </div>

      <main className="relative z-10 mx-auto grid max-w-7xl gap-6 px-6 pb-6 pt-40 md:grid-cols-[1fr_0.9fr] lg:pt-48">
        <section className="rounded-2xl border border-cyan-300/20 bg-slate-950/90 p-5 shadow-2xl shadow-cyan-950/40 backdrop-blur-md">
          <div className="mb-4 flex items-center justify-between border-b border-white/10 pb-3">
            <div className="text-cyan-300">
              viktoriya@portfolio:/{path.join("/")}$
            </div>
            <div className="flex gap-2">
              <span className="h-3 w-3 rounded-full bg-red-400" />
              <span className="h-3 w-3 rounded-full bg-yellow-400" />
              <span className="h-3 w-3 rounded-full bg-green-400" />
            </div>
          </div>

          <div
            ref={terminalRef}
            className="h-[420px] overflow-y-auto space-y-4 pr-2 text-sm leading-6"
          >
            <AnimatePresence initial={false}>
              {history.map((entry, index) => (
                <motion.div
                  key={`${entry.command}-${index}`}
                  initial={{ opacity: 0, y: 8 }}
                  animate={{ opacity: 1, y: 0 }}
                >
                  <div className="text-cyan-300">
                    viktoriya@portfolio:~$ {entry.command}
                  </div>

                  {entry.type === "project" && entry.project ? (
                    <div className="mt-2 rounded-xl border border-cyan-300/25 bg-cyan-300/5 p-4">
                      <h3 className="mb-2 text-lg font-semibold text-cyan-200">
                        {entry.project.title}
                      </h3>
                      <p className="mb-3 text-slate-200">
                        {entry.project.description}
                      </p>
                      <div className="flex flex-wrap gap-2">
                        {entry.project.stack.map((item) => (
                          <span
                            key={item}
                            className="rounded-full border border-cyan-300/25 bg-cyan-300/10 px-2 py-1 text-xs text-cyan-100"
                          >
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <pre className="whitespace-pre-wrap text-slate-100">
                      {entry.output}
                    </pre>
                  )}
                </motion.div>
              ))}
            </AnimatePresence>
          </div>

          <form
            onSubmit={(event) => {
              event.preventDefault();
              submit();
            }}
            className="mt-4 flex items-center gap-2 border-t border-white/10 pt-4"
          >
            <span className="text-cyan-300">
              viktoriya@portfolio:/{path.join("/")}$
            </span>
            <input
              value={input}
              onChange={(event) => setInput(event.target.value)}
              onKeyDown={handleKeyDown}
              className="min-w-0 flex-1 bg-transparent text-white outline-none placeholder:text-slate-500"
              placeholder="type command..."
              autoFocus
            />
          </form>

          <div className="mt-4 flex flex-wrap gap-2">
            {SHORTCUTS.map((shortcut) => (
              <button
                key={shortcut}
                type="button"
                onClick={() => submit(shortcut)}
                className="rounded-full border border-cyan-300/25 bg-slate-900/80 px-3 py-1 text-xs text-cyan-100 transition hover:border-cyan-200 hover:bg-cyan-300/10"
              >
                {shortcut}
              </button>
            ))}
          </div>
        </section>

        <aside className="rounded-2xl border border-cyan-300/20 bg-slate-950/90 p-5 shadow-2xl shadow-cyan-950/40 backdrop-blur-md">
          <h2 className="mb-4 text-xl font-semibold text-cyan-300">System</h2>

          <div className="space-y-5 text-sm text-slate-200">
            <div>
              <div className="mb-1 text-cyan-300">Current path</div>
              <div>/{path.join("/")}</div>
            </div>

            <div>
              <div className="mb-1 text-cyan-300">Directory contents</div>
              <div className="flex flex-wrap gap-2">
                {directoryItems.map((item) => (
                  <span
                    key={item}
                    className="rounded-full border border-white/10 bg-white/5 px-2 py-1 text-xs"
                  >
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <div>
              <div className="mb-1 text-cyan-300">Active project</div>
              <div className="font-semibold text-white">
                {currentProject.title}
              </div>
              <p className="mt-1 text-xs leading-5 text-slate-300">
                {currentProject.description}
              </p>
            </div>

            <div>
              <div className="mb-1 text-cyan-300">Project stack</div>
              <div className="flex flex-wrap gap-2">
                {currentProject.stack.map((item) => (
                  <span
                    key={item}
                    className="rounded-full border border-cyan-300/25 bg-cyan-300/10 px-2 py-1 text-xs text-cyan-100"
                  >
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <div>
              <div className="mb-1 text-cyan-300">Core skills</div>
              <div className="text-xs leading-6">
                React • TypeScript • Tailwind • Three.js • Accessibility • UI/UX
                • Adobe Photoshop • Adobe Illustrator • Adobe XD • Figma
              </div>
            </div>

            <div>
              <div className="mb-1 text-cyan-300">AI Assistant</div>
              <div className="rounded-xl border border-cyan-300/20 bg-black/35 p-3">
                <div className="mb-3 max-h-40 overflow-y-auto whitespace-pre-wrap text-xs leading-5 text-slate-200">
                  {aiAnswer}
                </div>
                <form
                  onSubmit={(event) => {
                    event.preventDefault();
                    submitAI();
                  }}
                  className="flex gap-2"
                >
                  <input
                    value={aiInput}
                    onChange={(event) => setAiInput(event.target.value)}
                    className="min-w-0 flex-1 rounded-lg border border-white/10 bg-slate-900/80 px-2 py-1 text-xs outline-none placeholder:text-slate-500"
                    placeholder="Ask about projects..."
                  />
                  <button
                    type="submit"
                    className="rounded-lg border border-cyan-300/25 px-3 py-1 text-xs text-cyan-100 hover:bg-cyan-300/10"
                  >
                    ask
                  </button>
                </form>
              </div>
            </div>

            <div>
              <div className="mb-1 text-cyan-300">Help</div>
              <div className="grid grid-cols-2 gap-2 text-xs">
                <div className="rounded-lg bg-white/5 p-2">whoami</div>
                <div className="rounded-lg bg-white/5 p-2">contact</div>
                <div className="rounded-lg bg-white/5 p-2">ls</div>
                <div className="rounded-lg bg-white/5 p-2">pwd</div>
                <div className="rounded-lg bg-white/5 p-2">cd projects</div>
                <div className="rounded-lg bg-white/5 p-2">cat ai-puzzle</div>
                <div className="rounded-lg bg-white/5 p-2">ask ...</div>
                <div className="rounded-lg bg-white/5 p-2">clear</div>
              </div>
            </div>
          </div>
        </aside>
      </main>
    </div>
  );
}
