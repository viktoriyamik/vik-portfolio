import express from "express";
import cors from "cors";
import fs from "fs";
import dotenv from "dotenv";
import OpenAI from "openai";

dotenv.config();

const app = express();

app.use(cors());
app.use(express.json({ limit: "2mb" }));

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

const INDEX_FILE = "./data/index/portfolio-index.json";

function loadIndex() {
  if (!fs.existsSync(INDEX_FILE)) {
    return [];
  }

  return JSON.parse(fs.readFileSync(INDEX_FILE, "utf8"));
}

let portfolioIndex = loadIndex();

function cosineSimilarity(a, b) {
  let dot = 0;
  let normA = 0;
  let normB = 0;

  for (let i = 0; i < a.length; i++) {
    dot += a[i] * b[i];
    normA += a[i] * a[i];
    normB += b[i] * b[i];
  }

  return dot / (Math.sqrt(normA) * Math.sqrt(normB));
}

async function embed(text) {
  const res = await client.embeddings.create({
    model: "text-embedding-3-small",
    input: text,
  });

  return res.data[0].embedding;
}

function retrieve(queryEmbedding, topK = 5) {
  return portfolioIndex
    .map((chunk) => ({
      ...chunk,
      score: cosineSimilarity(queryEmbedding, chunk.embedding),
    }))
    .sort((a, b) => b.score - a.score)
    .slice(0, topK);
}

app.get("/api/health", (_req, res) => {
  res.json({
    ok: true,
    chunks: portfolioIndex.length,
  });
});

app.post("/api/reload", (_req, res) => {
  portfolioIndex = loadIndex();

  res.json({
    ok: true,
    chunks: portfolioIndex.length,
  });
});

app.post("/api/ask", async (req, res) => {
  try {
    const question = String(req.body.question || "").trim();

    if (!question) {
      return res.status(400).json({
        error: "Missing question",
      });
    }

    if (!portfolioIndex.length) {
      return res.status(400).json({
        error: "Portfolio index is empty. Run: node server/ingest.mjs",
      });
    }

    const queryEmbedding = await embed(question);
    const matches = retrieve(queryEmbedding, 5);

    const context = matches
      .map(
        (m, i) =>
          `[Source ${i + 1}: ${m.file}, chunk ${m.chunkIndex}, score ${m.score.toFixed(
            3
          )}]\n${m.text}`
      )
      .join("\n\n---\n\n");

    const response = await client.responses.create({
      model: "gpt-4.1-mini",
      input: [
        {
          role: "system",
          content:
            "You are Viktoriya's portfolio AI assistant. Answer only using the provided portfolio context. If the context does not contain enough information, say that the uploaded project PDFs do not include enough detail. Be concise, professional, and helpful.",
        },
        {
          role: "user",
          content: `Portfolio context:\n\n${context}\n\nQuestion:\n${question}`,
        },
      ],
    });

    res.json({
      answer: response.output_text,
      sources: matches.map((m) => ({
        file: m.file,
        chunkIndex: m.chunkIndex,
        score: m.score,
        preview: m.text.slice(0, 220),
      })),
    });
  } catch (err) {
    console.error(err);

    res.status(500).json({
      error: "AI request failed",
    });
  }
});

const port = Number(process.env.PORT || 3001);

app.listen(port, () => {
  console.log(`PDF-aware AI backend running on port ${port}`);
});
